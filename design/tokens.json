{
  "schema_version": 1,
  "defaults": { "accent": "mauve", "reduce_motion": false, "mode": "dark", "motion": "normal",
                "palette": "catppuccin", "hue": null, "glass": false },

  "palette": {
    "rosewater": "#f5e0dc", "flamingo": "#f2cdcd", "pink": "#f5c2e7", "mauve": "#cba6f7",
    "red": "#f38ba8", "maroon": "#eba0ac", "peach": "#fab387", "yellow": "#f9e2af",
    "green": "#a6e3a1", "teal": "#94e2d5", "sky": "#89dceb", "sapphire": "#74c7ec",
    "blue": "#89b4fa", "lavender": "#b4befe",
    "text": "#cdd6f4", "subtext1": "#bac2de", "subtext0": "#a6adc8",
    "overlay2": "#9399b2", "overlay1": "#7f849c", "overlay0": "#6c7086",
    "surface2": "#585b70", "surface1": "#45475a", "surface0": "#313244",
    "base": "#1e1e2e", "mantle": "#181825", "crust": "#11111b"
  },
  "accents": ["rosewater", "flamingo", "pink", "mauve", "red", "maroon", "peach",
              "yellow", "green", "teal", "sky", "sapphire", "blue", "lavender"],

  "color": {
    "bg":     { "frame": "{palette.crust}", "base": "{palette.base}",
                "raised": "{palette.mantle}", "control": "{palette.surface0}" },
    "border": { "subtle": "{palette.surface1}" },
    "text":   { "primary": "{palette.text}", "muted": "{palette.subtext0}",
                "on_accent": "{palette.crust}" },
    "accent": "{accent}",
    "state":  { "success": "{palette.green}", "warning": "{palette.yellow}",
                "error": "{palette.red}", "info": "{palette.blue}" }
  },

  "term": {
    "fg": "{color.text.primary}", "bg": "{color.bg.base}",
    "cursor": "{color.accent}", "selection_bg": "{color.bg.control}",
    "ansi": ["{palette.surface1}", "{palette.red}", "{palette.green}", "{palette.yellow}",
             "{palette.blue}", "{palette.pink}", "{palette.teal}", "{palette.subtext1}",
             "{palette.surface2}", "{palette.red}", "{palette.green}", "{palette.yellow}",
             "{palette.blue}", "{palette.pink}", "{palette.teal}", "{palette.subtext0}"]
  },

  "console": {
    "ansi": ["{palette.base}", "{palette.red}", "{palette.green}", "{palette.yellow}",
             "{palette.blue}", "{accent}", "{palette.teal}", "{palette.text}",
             "{palette.surface2}", "{palette.red}", "{palette.green}", "{palette.yellow}",
             "{palette.blue}", "{accent}", "{palette.teal}", "{palette.subtext0}"],
    "slot": { "accent": "magenta", "text": "gray", "info": "blue", "surface": "black" }
  },

  "gtk": { "theme": "adw-gtk3-dark", "prefer_dark": 1, "color_scheme": "prefer-dark" },

  "light": {
    "palette": {
      "rosewater": "#dc8a78", "flamingo": "#dd7878", "pink": "#ea76cb", "mauve": "#8839ef",
      "red": "#d20f39", "maroon": "#e64553", "peach": "#fe640b", "yellow": "#df8e1d",
      "green": "#40a02b", "teal": "#179299", "sky": "#04a5e5", "sapphire": "#209fb5",
      "blue": "#1e66f5", "lavender": "#7287fd",
      "text": "#4c4f69", "subtext1": "#5c5f77", "subtext0": "#6c6f85",
      "overlay2": "#7c7f93", "overlay1": "#8c8fa1", "overlay0": "#9ca0b0",
      "surface2": "#acb0be", "surface1": "#bcc0cc", "surface0": "#ccd0da",
      "base": "#eff1f5", "mantle": "#e6e9ef", "crust": "#dce0e8"
    },
    "term": {
      "ansi": ["{palette.subtext1}", "{palette.red}", "{palette.green}", "{palette.yellow}",
               "{palette.blue}", "{palette.pink}", "{palette.teal}", "{palette.surface2}",
               "{palette.subtext0}", "{palette.red}", "{palette.green}", "{palette.yellow}",
               "{palette.blue}", "{palette.pink}", "{palette.teal}", "{palette.surface1}"]
    },
    "gtk": { "theme": "adw-gtk3", "prefer_dark": 0, "color_scheme": "prefer-light" }
  },

  "font": {
    "family": "JetBrainsMono Nerd Font",
    "icon": "JetBrainsMono Nerd Font Propo",
    "terminal_pt": 11,
    "ui_pt": 10,
    "size":   { "xs": 11, "sm": 12, "md": 13, "lg": 15, "xl": 18, "display": 28 },
    "weight": { "regular": 400, "emphasis": 600, "heavy": 800 }
  },
  "space":  { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32 },
  "radius": { "sm": 6, "md": 10, "lg": 14, "xl": 18, "full": 9999 },
  "border": { "thin": 1, "focus": 2 },
  "layout": { "frame": 10, "bar": 52, "gap_in": 5, "gap_out": 10, "osd_width": 46,
              "osd_height": 200, "notification_width": 360,
              "launcher_width": 560, "row": 52, "icon": 28, "button": 56,
              "thumb_width": 200, "thumb_height": 124, "card": 232, "ring": 92 },
  "timing": { "notification": 6000, "osd": 1600 },
  "motion": {
    "duration": { "fast": 120, "normal": 220, "slow": 360 },
    "ease": {
      "standard": [0.2, 0, 0, 1],
      "enter":    [0.05, 0.7, 0.1, 1],
      "exit":     [0.3, 0, 0.8, 0.15]
    }
  }
}
