[terminal]
vt = 1

[default_session]
command = "env TUIGREET_SECRET_MODE=characters TUIGREET_SECRET_CHARACTERS='*' tuigreet --time --remember --remember-user-session --cmd start-hyprland --theme 'border={{ console.slot.accent }};title={{ console.slot.accent }};greet={{ console.slot.text }};prompt={{ console.slot.accent }};input={{ console.slot.text }};action={{ console.slot.info }};button={{ console.slot.accent }};time={{ console.slot.text }};text={{ console.slot.text }};container={{ console.slot.surface }}'"
user = "greeter"
