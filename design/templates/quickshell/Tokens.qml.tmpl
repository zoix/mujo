pragma Singleton

import QtQuick
import Quickshell

Singleton {
    // Colour roles
    readonly property color bgFrame: "{{ color.bg.frame | hex }}"
    readonly property color bgBase: "{{ color.bg.base | hex }}"
    readonly property color bgRaised: "{{ color.bg.raised | hex }}"
    readonly property color bgControl: "{{ color.bg.control | hex }}"
    readonly property color borderSubtle: "{{ color.border.subtle | hex }}"
    readonly property color textPrimary: "{{ color.text.primary | hex }}"
    readonly property color textMuted: "{{ color.text.muted | hex }}"
    readonly property color textOnAccent: "{{ color.text.on_accent | hex }}"
    readonly property color accent: "{{ color.accent | hex }}"
    readonly property color stateSuccess: "{{ color.state.success | hex }}"
    readonly property color stateWarning: "{{ color.state.warning | hex }}"
    readonly property color stateError: "{{ color.state.error | hex }}"
    readonly property color stateInfo: "{{ color.state.info | hex }}"
    readonly property string accentName: {{ settings.accent | q }}

    // Typography
    readonly property string fontFamily: {{ font.family | q }}
    readonly property int fontXs: {{ font.size.xs }}
    readonly property int fontSm: {{ font.size.sm }}
    readonly property int fontMd: {{ font.size.md }}
    readonly property int fontLg: {{ font.size.lg }}
    readonly property int fontXl: {{ font.size.xl }}
    readonly property int fontDisplay: {{ font.size.display }}
    readonly property int weightRegular: {{ font.weight.regular }}
    readonly property int weightEmphasis: {{ font.weight.emphasis }}
    readonly property int weightHeavy: {{ font.weight.heavy }}

    // Spacing, shape, layout
    readonly property int spaceXs: {{ space.xs }}
    readonly property int spaceSm: {{ space.sm }}
    readonly property int spaceMd: {{ space.md }}
    readonly property int spaceLg: {{ space.lg }}
    readonly property int spaceXl: {{ space.xl }}
    readonly property int spaceXxl: {{ space.xxl }}
    readonly property int radiusSm: {{ radius.sm }}
    readonly property int radiusMd: {{ radius.md }}
    readonly property int radiusLg: {{ radius.lg }}
    readonly property int radiusXl: {{ radius.xl }}
    readonly property int radiusFull: {{ radius.full }}
    readonly property int borderThin: {{ border.thin }}
    readonly property int borderFocus: {{ border.focus }}
    readonly property int frame: {{ layout.frame }}
    readonly property int bar: {{ layout.bar }}
    readonly property int gapIn: {{ layout.gap_in }}
    readonly property int gapOut: {{ layout.gap_out }}
    readonly property int osdWidth: {{ layout.osd_width }}

    // Motion (durations are 0 when reduce_motion is on)
    readonly property bool reduceMotion: {{ settings.reduce_motion }}
    readonly property int durationFast: {{ motion.duration.fast | ms }}
    readonly property int durationNormal: {{ motion.duration.normal | ms }}
    readonly property int durationSlow: {{ motion.duration.slow | ms }}
    readonly property var easeStandard: {{ motion.ease.standard | qml_curve }}
    readonly property var easeEnter: {{ motion.ease.enter | qml_curve }}
    readonly property var easeExit: {{ motion.ease.exit | qml_curve }}
}
