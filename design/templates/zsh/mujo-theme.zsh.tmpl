# Sourced by ~/.config/zsh/.zshrc before the prompt and plugins load.

typeset -gA MUJO_COLOR=(
  accent    '{{ color.accent | hex }}'
  text      '{{ color.text.primary | hex }}'
  muted     '{{ color.text.muted | hex }}'
  subtle    '{{ color.border.subtle | hex }}'
  success   '{{ color.state.success | hex }}'
  warning   '{{ color.state.warning | hex }}'
  error     '{{ color.state.error | hex }}'
  info      '{{ color.state.info | hex }}'
)

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{ color.border.subtle | hex }}'

typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[default]='fg={{ color.text.primary | hex }}'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg={{ color.state.error | hex }}'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg={{ color.accent | hex }}'
ZSH_HIGHLIGHT_STYLES[alias]='fg={{ color.state.success | hex }}'
ZSH_HIGHLIGHT_STYLES[builtin]='fg={{ color.state.success | hex }}'
ZSH_HIGHLIGHT_STYLES[function]='fg={{ color.state.success | hex }}'
ZSH_HIGHLIGHT_STYLES[command]='fg={{ color.state.success | hex }}'
ZSH_HIGHLIGHT_STYLES[precommand]='fg={{ color.state.success | hex }},underline'
ZSH_HIGHLIGHT_STYLES[path]='fg={{ color.state.info | hex }}'
ZSH_HIGHLIGHT_STYLES[globbing]='fg={{ color.accent | hex }}'
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg={{ color.state.warning | hex }}'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg={{ color.state.warning | hex }}'
ZSH_HIGHLIGHT_STYLES[comment]='fg={{ color.text.muted | hex }}'
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg={{ color.accent | hex }}'
