font-family = {{ font.family }}
font-size = {{ font.terminal_pt }}
window-padding-x = {{ space.sm }}
# No fixed padding at the bottom: the rows never fill the window exactly, and
# what is left over is shared between the top and the bottom, which is
# padding enough. The last row (the tmux status line) then sits near the edge.
window-padding-y = {{ space.sm }},0
window-padding-balance = equal
# The padding takes the colour of the cells next to it, so a bar that runs
# the width of the terminal (Neovim's status line, and tmux's under it)
# reaches the window's edges instead of stopping short of them.
window-padding-color = extend

foreground = {{ term.fg | hex }}
background = {{ term.bg | hex }}
selection-foreground = {{ term.fg | hex }}
selection-background = {{ term.selection_bg | hex }}
cursor-color = {{ term.cursor | hex }}
cursor-text = {{ term.bg | hex }}
split-divider-color = {{ color.border.subtle | hex }}
background-opacity = {{ term.opacity }}
background-blur = {{ term.blur }}

palette = 0={{ term.ansi.0 | hex }}
palette = 1={{ term.ansi.1 | hex }}
palette = 2={{ term.ansi.2 | hex }}
palette = 3={{ term.ansi.3 | hex }}
palette = 4={{ term.ansi.4 | hex }}
palette = 5={{ term.ansi.5 | hex }}
palette = 6={{ term.ansi.6 | hex }}
palette = 7={{ term.ansi.7 | hex }}
palette = 8={{ term.ansi.8 | hex }}
palette = 9={{ term.ansi.9 | hex }}
palette = 10={{ term.ansi.10 | hex }}
palette = 11={{ term.ansi.11 | hex }}
palette = 12={{ term.ansi.12 | hex }}
palette = 13={{ term.ansi.13 | hex }}
palette = 14={{ term.ansi.14 | hex }}
palette = 15={{ term.ansi.15 | hex }}
