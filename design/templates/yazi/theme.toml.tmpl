[mgr]
cwd            = { fg = "{{ color.accent | hex }}" }
find_keyword   = { fg = "{{ color.state.warning | hex }}", bold = true }
find_position  = { fg = "{{ color.accent | hex }}", bold = true }
marker_copied   = { fg = "{{ color.state.success | hex }}", bg = "{{ color.state.success | hex }}" }
marker_cut      = { fg = "{{ color.state.error | hex }}", bg = "{{ color.state.error | hex }}" }
marker_marked   = { fg = "{{ color.accent | hex }}", bg = "{{ color.accent | hex }}" }
marker_selected = { fg = "{{ color.state.warning | hex }}", bg = "{{ color.state.warning | hex }}" }
count_copied   = { fg = "{{ color.text.on_accent | hex }}", bg = "{{ color.state.success | hex }}" }
count_cut      = { fg = "{{ color.text.on_accent | hex }}", bg = "{{ color.state.error | hex }}" }
count_selected = { fg = "{{ color.text.on_accent | hex }}", bg = "{{ color.state.warning | hex }}" }
border_style   = { fg = "{{ color.border.subtle | hex }}" }

[tabs]
active   = { fg = "{{ color.text.on_accent | hex }}", bg = "{{ color.accent | hex }}", bold = true }
inactive = { fg = "{{ color.text.muted | hex }}", bg = "{{ color.bg.control | hex }}" }

[mode]
normal_main = { fg = "{{ color.text.on_accent | hex }}", bg = "{{ color.accent | hex }}", bold = true }
normal_alt  = { fg = "{{ color.accent | hex }}", bg = "{{ color.bg.control | hex }}" }
select_main = { fg = "{{ color.text.on_accent | hex }}", bg = "{{ color.state.info | hex }}", bold = true }
select_alt  = { fg = "{{ color.state.info | hex }}", bg = "{{ color.bg.control | hex }}" }
unset_main  = { fg = "{{ color.text.on_accent | hex }}", bg = "{{ color.state.error | hex }}", bold = true }
unset_alt   = { fg = "{{ color.state.error | hex }}", bg = "{{ color.bg.control | hex }}" }

[indicator]
parent  = { fg = "{{ color.text.primary | hex }}", bg = "{{ color.bg.control | hex }}" }
current = { fg = "{{ color.text.primary | hex }}", bg = "{{ color.bg.control | hex }}" }
preview = { underline = true }

[status]
perm_sep   = { fg = "{{ color.border.subtle | hex }}" }
perm_type  = { fg = "{{ color.state.info | hex }}" }
perm_read  = { fg = "{{ color.state.warning | hex }}" }
perm_write = { fg = "{{ color.state.error | hex }}" }
perm_exec  = { fg = "{{ color.state.success | hex }}" }
progress_label  = { fg = "{{ color.text.primary | hex }}", bold = true }
progress_normal = { fg = "{{ color.accent | hex }}", bg = "{{ color.bg.control | hex }}" }
progress_error  = { fg = "{{ color.state.error | hex }}", bg = "{{ color.bg.control | hex }}" }

[which]
border = { fg = "{{ color.border.subtle | hex }}" }
cand   = { fg = "{{ color.accent | hex }}" }
rest   = { fg = "{{ color.text.muted | hex }}" }
desc   = { fg = "{{ color.text.primary | hex }}" }
separator_style = { fg = "{{ color.border.subtle | hex }}" }

[confirm]
border = { fg = "{{ color.accent | hex }}" }
title  = { fg = "{{ color.accent | hex }}" }

[spot]
border = { fg = "{{ color.accent | hex }}" }
title  = { fg = "{{ color.accent | hex }}" }

[notify]
title_info  = { fg = "{{ color.state.info | hex }}" }
title_warn  = { fg = "{{ color.state.warning | hex }}" }
title_error = { fg = "{{ color.state.error | hex }}" }

[pick]
border = { fg = "{{ color.accent | hex }}" }
active = { fg = "{{ color.accent | hex }}", bold = true }

[input]
border = { fg = "{{ color.accent | hex }}" }

[cmp]
border = { fg = "{{ color.accent | hex }}" }

[tasks]
border  = { fg = "{{ color.accent | hex }}" }
hovered = { fg = "{{ color.accent | hex }}", bold = true }

[help]
border  = { fg = "{{ color.accent | hex }}" }
chord   = { fg = "{{ color.accent | hex }}" }
hovered = { fg = "{{ color.text.primary | hex }}", bg = "{{ color.bg.control | hex }}" }

[filetype]
rules = [
	{ mime = "**/image/*", fg = "{{ color.state.warning | hex }}" },
	{ mime = "**/{audio,video}/*", fg = "{{ color.accent | hex }}" },
	{ mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{ color.state.error | hex }}" },
	{ url = "*", is = "orphan", fg = "{{ color.state.error | hex }}" },
	{ url = "*", is = "exec", fg = "{{ color.state.success | hex }}" },
	{ url = "*/", fg = "{{ color.state.info | hex }}" },
]
