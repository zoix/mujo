// Installed by mujo (install.sh) for `mujo time auto`.
// Someone in the wheel group, logged in at this machine, may change the
// time zone without a password prompt. Nothing else is allowed by this.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.timedate1.set-timezone" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
