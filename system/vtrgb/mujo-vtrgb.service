# Installed by mujo's install.sh to /etc/systemd/system/mujo-vtrgb.service.
# Loads the console palette generated from design/tokens.json
# (/etc/mujo/palette.vtrgb) into every virtual console, before the greeter
# draws on tty1.

[Unit]
Description=mujo console palette
After=systemd-vconsole-setup.service
Before=greetd.service getty@tty1.service
ConditionPathExists=/etc/mujo/palette.vtrgb

[Service]
Type=oneshot
ExecStart=/usr/bin/setvtrgb /etc/mujo/palette.vtrgb
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
