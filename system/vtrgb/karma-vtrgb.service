# Installed by karma's install.sh to /etc/systemd/system/karma-vtrgb.service.
# Loads the console palette generated from design/tokens.json
# (/etc/karma/palette.vtrgb) into every virtual console, before the greeter
# draws on tty1.

[Unit]
Description=karma console palette
After=systemd-vconsole-setup.service
Before=greetd.service getty@tty1.service
ConditionPathExists=/etc/karma/palette.vtrgb

[Service]
Type=oneshot
ExecStart=/usr/bin/setvtrgb /etc/karma/palette.vtrgb
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
