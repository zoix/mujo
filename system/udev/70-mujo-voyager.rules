# Installed by mujo (install.sh) for `mujo voyager flash`.
# Whoever is logged in at this machine may write firmware to a ZSA Voyager
# that is in its bootloader (after its reset button was pressed). Nothing
# else is allowed by this. The number has to stay below 73 for uaccess.
SUBSYSTEM=="usb", ATTR{idVendor}=="3297", ATTR{idProduct}=="0791", TAG+="uaccess"
