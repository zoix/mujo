#compdef karma
# zsh completion for karma. Accent names come from karma itself.

_karma_accents() {
  local -a names
  names=(${(f)"$(karma theme accent --json 2>/dev/null | jq -r '.data.available[]?' 2>/dev/null)"})
  _describe -t accents 'accent' names
}

_karma_consumers() {
  local -a ids
  ids=(${(f)"$(karma theme list --json 2>/dev/null | jq -r '.data.consumers[].id' 2>/dev/null)"})
  _describe -t consumers 'consumer' ids
}

_karma_journal_ids() {
  local -a ids
  ids=(${(f)"$(karma log --json --limit 30 2>/dev/null | jq -r '.data.entries[] | "\(.id):\(.summary)"' 2>/dev/null)"})
  _describe -t entries 'journal entry' ids
}

_karma() {
  local -a globals
  globals=(
    '--json[print one JSON object]'
    '--dry-run[show what would change and change nothing]'
    '(--yes -y)'{--yes,-y}'[confirm actions that cannot be undone]'
    '(--help -h)'{--help,-h}'[show help]'
  )

  local curcontext=$curcontext state
  local -a commands
  commands=(
    'theme:design tokens: build, check, accent, reduce-motion'
    'log:list recent actions'
    'undo:revert an action'
    'version:print the version'
    'help:show help for a command'
  )

  _arguments -C $globals '1:command:->command' '*::argument:->argument' && return

  case $state in
    command) _describe -t commands 'karma command' commands ;;
    argument)
      case $words[1] in
        theme)
          if (( CURRENT == 2 )); then
            local -a subs
            subs=(
              'build:render every consumer from the tokens'
              'check:fail on drift or hardcoded values'
              'accent:show or set the accent colour'
              'reduce-motion:show or set reduce_motion'
              'list:list consumers and their status'
              'show:print resolved tokens'
              'render:render a template to stdout'
              'restore:put back files saved by a build'
            )
            _describe -t subcommands 'theme subcommand' subs
          else
            case $words[2] in
              accent) _karma_accents ;;
              reduce-motion) _values 'state' on off ;;
              build|check) _karma_consumers ;;
              render) _files ;;
            esac
          fi
          ;;
        undo) _karma_journal_ids ;;
        log) _arguments '--limit[number of entries]:count' ;;
        help) _describe -t commands 'karma command' commands ;;
      esac
      ;;
  esac
}

_karma "$@"
