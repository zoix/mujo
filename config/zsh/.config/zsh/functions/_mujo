#compdef mujo
# zsh completion for mujo. Accent names come from mujo itself.

_mujo_accents() {
  local -a names
  names=(${(f)"$(mujo theme accent --json 2>/dev/null | jq -r '.data.available[]?' 2>/dev/null)"})
  _describe -t accents 'accent' names
}

_mujo_consumers() {
  local -a ids
  ids=(${(f)"$(mujo theme list --json 2>/dev/null | jq -r '.data.consumers[].id' 2>/dev/null)"})
  _describe -t consumers 'consumer' ids
}

_mujo_journal_ids() {
  local -a ids
  ids=(${(f)"$(mujo log --json --limit 30 2>/dev/null | jq -r '.data.entries[] | "\(.id):\(.summary)"' 2>/dev/null)"})
  _describe -t entries 'journal entry' ids
}

_mujo_devices() {
  local -a ids
  ids=(${(f)"$(mujo audio $1 --json 2>/dev/null | jq -r '.data.devices[] | "\(.name | gsub(":"; "\\:")):\(.description)"' 2>/dev/null)"})
  _describe -t devices 'device' ids
}

_mujo_networks() {
  local -a names
  names=(${(f)"$(mujo net scan --no-rescan --json 2>/dev/null | jq -r "$1" 2>/dev/null)"})
  compadd -a names
}

_mujo_apps() {
  local -a ids
  ids=(${(f)"$(mujo launch list --json 2>/dev/null | jq -r '.data.apps[] | "\(.id):\(.name)"' 2>/dev/null)"})
  _describe -t apps 'application' ids
}

_mujo() {
  local -a globals
  globals=(
    '--json[print one JSON object]'
    '--dry-run[show what would change and change nothing]'
    '(--yes -y)'{--yes,-y}'[confirm actions that cannot be undone]'
    '--window[open in a floating terminal]'
    '(--help -h)'{--help,-h}'[show help]'
  )

  local curcontext=$curcontext state
  local -a commands
  commands=(
    'status:one snapshot of audio, network, display, theme, battery'
    'audio:volume, mute, output and input device'
    'net:Wi-Fi status, scan, connect, forget'
    'bt:Bluetooth status and power'
    'display:brightness and night light'
    'theme:design tokens: build, check, accent, reduce-motion'
    'wall:set or cycle the wallpaper'
    'dnd:do not disturb for notifications'
    'focus:focus timer with do not disturb'
    'weather:current weather for a place you choose'
    'record:record the screen or a region'
    'calc:calculate an expression'
    'emoji:emoji picker'
    'term:show or hide the drop-down terminal'
    'power:lock, suspend, logout, reboot, shutdown'
    'shot:region, window or screen screenshot'
    'clip:clipboard history picker'
    'launch:application launcher'
    'menu:system menu'
    'keys:keybinding cheat sheet'
    'pkg:search, install and remove packages'
    'sys:processor, memory, temperature, disk, uptime'
    'doctor:check dependencies, services, links and tokens'
    'update:update mujo and the system'
    'uninstall:remove mujo and restore the backups'
    'log:list recent actions'
    'undo:revert an action'
    'version:print the version'
    'help:show help for a command'
  )

  _arguments -C $globals '1:command:->command' '*::argument:->argument' && return

  case $state in
    command) _describe -t commands 'mujo command' commands ;;
    argument)
      case $words[1] in
        theme)
          if (( CURRENT == 2 )); then
            local -a subs
            subs=(
              'build:render every consumer from the tokens'
              'check:fail on drift or hardcoded values'
              'accent:show or set the accent colour'
              'palette:catppuccin, or colours from the wallpaper'
              'mode:dark, light or auto (follow the wallpaper)'
              'motion:normal or gentle animations'
              'glass:see-through panels'
              'reduce-motion:show or set reduce_motion'
              'list:list consumers and their status'
              'show:print resolved tokens'
              'render:render a template to stdout'
              'restore:put back files saved by a build'
            )
            _describe -t subcommands 'theme subcommand' subs
          else
            case $words[2] in
              accent) _mujo_accents ;;
              palette) _values 'palette' catppuccin wallpaper ;;
              mode) _values 'mode' dark light auto ;;
              motion) _values 'motion' normal gentle ;;
              glass) _values 'state' on off toggle ;;
              reduce-motion) _values 'state' on off ;;
              build|check) _mujo_consumers ;;
              render) _files ;;
            esac
          fi
          ;;
        audio)
          if (( CURRENT == 2 )); then
            _values 'audio subcommand' status volume mute output input tui
          else
            case $words[2] in
              mute) _values 'state' on off toggle --input ;;
              volume) _values 'option' --input ;;
              output) _mujo_devices output ;;
              input) _mujo_devices input ;;
            esac
          fi
          ;;
        net)
          if (( CURRENT == 2 )); then
            _values 'net subcommand' status scan connect disconnect forget wifi tui
          else
            case $words[2] in
              connect) _mujo_networks '.data.networks[].ssid' ;;
              forget) _mujo_networks '.data.networks[] | select(.saved) | .ssid' ;;
              wifi) _values 'state' on off toggle ;;
              scan) _values 'option' --no-rescan ;;
            esac
          fi
          ;;
        bt)
          if (( CURRENT == 2 )); then
            _values 'bt subcommand' status power tui
          elif [[ $words[2] == power ]]; then
            _values 'state' on off toggle
          fi
          ;;
        display)
          if (( CURRENT == 2 )); then
            _values 'display subcommand' status brightness night
          elif [[ $words[2] == night ]]; then
            _values 'state' on off toggle --temp
          fi
          ;;
        wall)
          if (( CURRENT == 2 )); then
            _values 'wall subcommand' status pick set next prev clear dir clock list index
          else
            case $words[2] in
              set) _files -g '*.(png|jpg|jpeg|webp)(-.)' ;;
              dir) _files -/ ;;
            esac
          fi
          ;;
        pkg) (( CURRENT == 2 )) && _values 'pkg subcommand' install remove list ;;
        update) _values 'option' check snapshots rollback --refresh --mujo-only --system-only --no-snapshot ;;
        uninstall) _values 'option' --skip-system ;;
        dnd) (( CURRENT == 2 )) && _values 'state' on off toggle ;;
        focus) (( CURRENT == 2 )) && _values 'focus subcommand' status start stop ;;
        weather) (( CURRENT == 2 )) && _values 'weather subcommand' show set units clear --refresh ;;
        record) _values 'record subcommand or option' toggle start stop status region screen --audio --dir ;;
        emoji) (( CURRENT == 2 )) && _values 'emoji subcommand' pick list copy ;;
        power) (( CURRENT == 2 )) && _values 'action' list lock suspend logout reboot shutdown profile awake limit auto sync ;;
        shot) _values 'mode or option' region window screen text --no-save --no-copy --dir --lang ;;
        clip) (( CURRENT == 2 )) && _values 'clip subcommand' pick list copy clear ;;
        launch)
          if (( CURRENT == 2 )); then
            _values 'launch subcommand' pick list run
          elif [[ $words[2] == run ]]; then
            _mujo_apps
          fi
          ;;
        menu) (( CURRENT == 2 )) && _values 'menu subcommand' pick list ;;
        keys) (( CURRENT == 2 )) && _values 'keys subcommand' list tui ;;
        undo) _mujo_journal_ids ;;
        log) _arguments '--limit[number of entries]:count' ;;
        help) _describe -t commands 'mujo command' commands ;;
      esac
      ;;
  esac
}

_mujo "$@"
