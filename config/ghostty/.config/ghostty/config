# Ghostty: mujo's terminal.
# Colours, font and padding come from mujo-theme, which `mujo theme build`
# generates from design/tokens.json. Do not put colours here.
config-file = mujo-theme

# The compositor draws the border; no title bar.
window-decoration = none
window-theme = ghostty
confirm-close-surface = false
resize-overlay = never

cursor-style = bar
cursor-style-blink = false
shell-integration-features = no-cursor

# Selecting text copies it to both clipboards, and a middle click (a
# three-finger tap on the touchpad) pastes the system clipboard, the same
# thing Ctrl+Shift+V pastes. Ghostty's default pastes the selection clipboard,
# which programs that draw their own selection (Claude Code, Neovim, tmux
# with the mouse on) never fill: they copy to the system clipboard only.
copy-on-select = both
middle-click-action = clipboard-paste
# A right click (a two-finger tap on the touchpad) pastes too, instead of
# opening Ghostty's menu.
right-click-action = paste
scrollback-limit-bytes = 10000000
auto-update = off

# Ghostty binds Ctrl+Enter to fullscreen by default. Terminal programs use
# that key themselves (Claude Code sends a message with it), so it is passed
# through; SUPER + Shift + F makes any window fullscreen.
keybind = ctrl+enter=unbind

# Your own settings: create ~/.config/ghostty/local (optional, never overwritten).
config-file = ?local
